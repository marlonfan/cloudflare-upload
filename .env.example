# ============================================
# 环境变量模板：复制为 .env 并填入真实值
#   cp .env.example .env
#
# 本地开发：wrangler dev 会自动加载 .env
# 生产部署：无需 .env，改用 wrangler secret put 逐项设置：
#   wrangler secret put TELEGRAM_BOT_TOKEN
#   wrangler secret put TELEGRAM_CHAT_IDS
#   wrangler secret put WEB_UPLOAD_PASSWORD
#   （公开域名等非机密项也可用 wrangler.jsonc 的 vars 配置）
# ============================================

# Telegram 机器人 token（机密，必填）
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 允许访问机器人的用户 ID，多个用英文逗号分隔（隐私，必填）
TELEGRAM_CHAT_IDS=123456789

# 网页上传访问密码（机密，必填）
WEB_UPLOAD_PASSWORD=change-me

# R2 存储绑定名（需与 wrangler.jsonc 中 r2_buckets.binding 一致）
R2_BUCKET_NAME=static

# 公开访问域名（不填则使用 worker.js 中的默认值）
BASE_CF_URL=https://cdn.example.com
BASE_URL=https://r2.example.com
